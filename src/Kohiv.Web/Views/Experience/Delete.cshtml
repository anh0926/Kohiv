@model DeleteExperienceViewModel

@{
    ViewData["Title"] = "Delete Experience";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="border rounded p-4 bg-light">
            <h1 class="h3 text-danger">Delete Experience</h1>

            <p>
                Are you sure you want to delete
                <strong>@Model.Title</strong>?
            </p>

            <dl class="row">
                <dt class="col-sm-4">Category</dt>
                <dd class="col-sm-8">@Model.CategoryName</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@Model.Status</dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger">Delete Experience</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
