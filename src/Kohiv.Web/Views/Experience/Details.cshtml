@model ExperienceDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">&larr; Back to Experiences</a>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
</div>

<div class="border rounded p-4 bg-light">
    <div class="mb-3">
        <h1 class="mb-2">@Model.Title</h1>
        <div class="d-flex gap-2">
            <span class="badge text-bg-primary">@Model.CategoryName</span>
            <span class="badge text-bg-secondary">@Model.Status</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="lead">@Model.Description</p>
    }

    <dl class="row mb-0">
        @if (!string.IsNullOrWhiteSpace(Model.Location))
        {
            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@Model.Location</dd>
        }

        @if (!string.IsNullOrWhiteSpace(Model.SourceUrl))
        {
            <dt class="col-sm-3">Source URL</dt>
            <dd class="col-sm-9">
                <a href="@Model.SourceUrl" target="_blank" rel="noopener noreferrer">
                    @Model.SourceUrl
                </a>
            </dd>
        }

        <dt class="col-sm-3">Created</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToShortDateString()</dd>

        <dt class="col-sm-3">Updated</dt>
        <dd class="col-sm-9">@Model.UpdatedAt.ToShortDateString()</dd>
    </dl>
</div>
